{
  "name": "smartrobotics-video-player",
  "productName": "SmartVideoPlayer",
  "version": "1.0.0",
  "description": "동영상 파일을 여는 간단한 플레이어",
  "author": "smartrobotics",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir --x64",
    "dist": "npm run pack && node build/make-installer.js"
  },
  "build": {
    "appId": "com.smartrobotics.videoplayer",
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "extraResources": [
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  }
}